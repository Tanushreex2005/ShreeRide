# ShreeRide VFX - Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-here-generate-with-python-secrets-module

# MySQL Database (for local development and production with external MySQL)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=ridex_db

# For Render deployment with PostgreSQL (alternative to MySQL)
# DATABASE_URL=postgresql://user:password@host:port/database
# Note: Render automatically provides DATABASE_URL when you add a PostgreSQL database

# Google Maps API Key (optional - for map features)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
